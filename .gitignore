# Repo-root ignores. Each app also has its own .gitignore; this file covers
# the root itself, which previously had none -- a root secrets file sat
# untracked but unignored, one `git add -A` away from being committed.

# Environment files. .env.shared holds the values backend/ and
# ai-injury-assistant/ must agree on (JWT_SECRET, DATABASE_URL).
.env
.env.*
!.env.example
!.env*.example

# Dependencies / build output that can appear at the root
node_modules/

# OS noise
.DS_Store
Thumbs.db
