# Copy to .env (git-ignored) and fill in. This is the single home for both
# backend/'s and ai-injury-assistant/'s configuration.
#
# Loading order: each app reads its own .env.test first when NODE_ENV=test,
# then this file. dotenv never overwrites an already-set variable, so a test
# file always wins -- that is what keeps the test database authoritative when
# running the suites, and it is not decorative: the suites TRUNCATE every
# table, and they once wiped the development database when this went wrong.
#
# Not read by frontend/ -- its NEXT_PUBLIC_* values compile into the browser
# bundle and stay in frontend/.env.local, well away from anything secret.
# Not read by ai-injury-extractor/ -- it is an AWS Lambda fed by Terraform.
# (backend/ does need the two EXTRACTOR_* values below to reach that Lambda,
# but the Lambda itself still takes its own copy from Terraform.)
#
# On a hosted deploy there is no file; set these in the platform's environment
# settings instead. Both apps throw at startup if JWT_SECRET or DATABASE_URL
# is missing.

# --- shared: backend/ issues tokens, ai-injury-assistant/ verifies them ---
# If JWT_SECRET differs between the two, every assistant request fails as
# "unauthenticated" with nothing in the logs explaining why. Both apps also
# read the same database; backend/prisma/ owns its schema, including the
# DocumentChunk table the assistant writes vectors into.
JWT_SECRET=
DATABASE_URL=
NODE_ENV=development

# --- backend/ ---
# Ports are namespaced because both apps read a bare PORT, and hosts such as
# Render inject PORT themselves. Each app prefers PORT, then its own name here.
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
# Where backend/ proxies POST /api/assistant/ask. Defaults to :3002 if unset.
AI_ASSISTANT_URL=http://localhost:3002
# Where backend/ proxies the AI extractor routes: the API Gateway stage URL
# from `terraform output` in ai-injury-extractor/infrastructure/, no trailing
# slash. Both extractor routes answer 503 while these are unset.
EXTRACTOR_API_URL=
# Proves to the Lambda that the caller is this backend -- it 403s anything
# else, which is what stops the internet reading everyone's injury text
# (issue #32). Must equal TF_VAR_extractor_shared_secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTRACTOR_SHARED_SECRET=

# --- ai-injury-assistant/ ---
ASSISTANT_PORT=3002
# Required. Answer generation via Groq.
GROQ_API_KEY=
# Required. Bearer token for the Python embedding service; must also be set in
# that service's own process environment (docker compose passes it through).
EMBEDDING_API_KEY=
EMBEDDING_API_URL=http://127.0.0.1:8000
# Required in production only. Comma-separated CORS origins.
ALLOWED_ORIGIN=

# --- optional tuning; defaults live in ai-injury-assistant/src/config/ ---
# CHUNK_MAX_TOKENS=
# INJURY_MATCH_AMBIGUITY_MARGIN=
# MAX_MATCHED_INJURIES=
# INJURY_MATCH_FALLBACK_DISTANCE=

# DATABASE_ENV and SEED_DEV_CONFIRM are deliberately NOT here. They gate
# prisma/seed-dev.ts, which opens with a TRUNCATE, and must stay opt-in on the
# command line rather than sitting armed in a file.
