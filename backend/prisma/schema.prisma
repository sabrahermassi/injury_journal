// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  injuries Injury[]
}

model Injury {
  id          Int      @id @default(autoincrement())
  name        String
  bodyArea    String
  side        String?
  startDate   DateTime
  cause       String?
  description String?
  status      String?
  createdAt   DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  timelineEvents TimelineEvent[]
  symptoms       Symptom[]
  treatments     Treatment[]
  medicalVisits  MedicalVisit[]
  documentChunks DocumentChunk[]
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  type        String
  date        DateTime
  description String
  result      String?

  injuryId Int
  injury   Injury @relation(fields: [injuryId], references: [id])
}

model Symptom {
  id        Int      @id @default(autoincrement())
  date      DateTime
  painLevel Int
  location  String?
  trigger   String?
  duration  String?
  notes     String?

  injuryId Int
  injury   Injury @relation(fields: [injuryId], references: [id])
}

model Treatment {
  id       Int      @id @default(autoincrement())
  name     String
  provider String?
  date     DateTime
  cost     Float?

  // Legacy free-text outcome, kept for existing rows and backfilled into
  // TreatmentOutcome. New outcome observations go to TreatmentOutcome instead —
  // writing here overwrites history, which is what this model exists to stop.
  outcome String?

  // When to ask the user how this treatment worked out. Null means never ask.
  followUpDueAt DateTime?

  // Groups repeated attempts at the same treatment (e.g. a course of
  // injections) so they can be compared as a series rather than by name match.
  courseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  injuryId Int
  injury   Injury @relation(fields: [injuryId], references: [id])

  outcomes TreatmentOutcome[]
}

// One observation of how a treatment is working, recorded *after* the fact.
// A treatment accrues several of these over time ("still helping" at 2 weeks,
// "wearing off" at 8) and none of them overwrite each other.
model TreatmentOutcome {
  id         Int      @id @default(autoincrement())
  recordedAt DateTime @default(now())
  status     String
  reliefDays Int?
  painLevel  Int?
  notes      String?
  createdAt  DateTime @default(now())

  treatmentId Int
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([treatmentId])
}

model MedicalVisit {
  id     Int      @id @default(autoincrement())
  doctor String?
  clinic String?
  date   DateTime
  notes  String?

  injuryId Int
  injury   Injury @relation(fields: [injuryId], references: [id])
}
// Vector store for the AI assistant (ai-injury-assistant/). That service reads
// this database but never migrates it -- this app owns the schema -- so the
// table is declared here even though nothing in backend/ queries it.
//
// `embedding` is Unsupported because Prisma has no vector type. Prisma Client
// cannot select it; the assistant reads it with raw SQL.
model DocumentChunk {
  id                    Int                          @id @default(autoincrement())
  injuryId              Int
  userId                Int
  sourceType            String
  sourceId              Int
  chunkIndex            Int
  content               String
  embedding             Unsupported("vector(1024)")?
  embeddingModel        String
  embeddingModelVersion String
  metadata              Json?
  createdAt             DateTime                     @default(now())

  injury Injury @relation(fields: [injuryId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([injuryId])
  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([embeddingModel, embeddingModelVersion])
}
