# Dependencies
node_modules/

# Environment variables. Runtime config now lives in the repo-root .env;
# .env.test stays here because the test-database guard in tests/setup.js
# depends on it overriding the root file.
.env
.env.*
!.env.example

# Prisma generated files
src/generated/prisma/

# AI/editor configuration
.agents/
.claude/
.windsurf/

# REST Client scratch files: these hold real JWTs pasted from login
# responses. Only requests.http.example (placeholders only) is tracked --
# it ends in .example, so this pattern never matches it.
*.http