# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/injury_journal

# Auth
JWT_SECRET=your_jwt_secret_here

# Corti — https://console.corti.app -> Developer Quickstart
CORTI_TENANT_NAME=your_tenant_name_here
CORTI_ENVIRONMENT=eu

# Backend API client — full access, server-side only (Guided Documents extraction, etc.)
CORTI_CLIENT_ID=your_client_id_here
CORTI_CLIENT_SECRET=your_client_secret_here

# Dedicated transcription client — minimal/transcribe-only scopes, used solely to mint
# short-lived browser tokens for the <corti-dictation> mic widget. Must be a separate
# Corti API client from the one above; never give it broader scopes than transcription.
CORTI_TRANSCRIBE_CLIENT_ID=your_transcribe_client_id_here
CORTI_TRANSCRIBE_CLIENT_SECRET=your_transcribe_client_secret_here
