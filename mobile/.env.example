# Copy to .env.local (git-ignored) and set the address for YOUR machine.
#
# EXPO_PUBLIC_* is compiled into the app bundle, exactly like NEXT_PUBLIC_* on
# the web side, so nothing secret belongs in this file. The backend's real
# configuration stays in the repo-root .env.
#
# This must be a LAN IP, not localhost: the bundle runs on the phone, where
# "localhost" is the phone. Find yours with `ipconfig` (IPv4 Address on the
# Wi-Fi adapter) and make sure the same address is listed in the root .env's
# comma-separated FRONTEND_URL, or the API will reject the origin.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
