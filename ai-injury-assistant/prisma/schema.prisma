generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}
  
model Injury {
  id            Int             @id @default(autoincrement())
  name          String
  bodyArea      String
  side          String?
  startDate     DateTime
  cause         String?
  description   String?
  status        String?
  createdAt     DateTime        @default(now())
  userId        Int
  
  User          User            @relation(fields: [userId], references: [id])
  MedicalVisit  MedicalVisit[]
  Symptom       Symptom[]
  TimelineEvent TimelineEvent[]
  Treatment     Treatment[]
  DocumentChunk DocumentChunk[]

  @@index([userId])
}

model MedicalVisit {
  id       Int      @id @default(autoincrement())
  doctor   String?
  clinic   String?
  date     DateTime
  notes    String?
  injuryId Int
  Injury   Injury   @relation(fields: [injuryId], references: [id])

   @@index([injuryId])
}

model Symptom {
  id        Int      @id @default(autoincrement())
  date      DateTime
  painLevel Int
  location  String?
  trigger   String?
  duration  String?
  notes     String?
  injuryId  Int
  Injury    Injury   @relation(fields: [injuryId], references: [id])

   @@index([injuryId])
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  type        String
  date        DateTime
  description String
  result      String?
  injuryId    Int
  Injury      Injury   @relation(fields: [injuryId], references: [id])

   @@index([injuryId])
}

model Treatment {
  id            Int      @id @default(autoincrement())
  name          String
  provider      String?
  date          DateTime
  cost          Float?
  outcome       String?
  followUpDueAt DateTime?
  courseId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  injuryId      Int
  Injury        Injury   @relation(fields: [injuryId], references: [id])

  TreatmentOutcome TreatmentOutcome[]

   @@index([injuryId])
}

// One recorded observation of how a treatment worked out, logged after the
// fact. A treatment accrues several over time and none overwrite each other,
// which is what makes a course of repeated attempts comparable.
//
// backend/prisma/ owns this table; it is declared here only so this service's
// Prisma Client can read it. Without it, check-ins are invisible to the
// assistant and treatment effectiveness can only be inferred from the older
// free-text Treatment.outcome or from a doctor's note.
model TreatmentOutcome {
  id          Int      @id @default(autoincrement())
  recordedAt  DateTime @default(now())
  status      String
  reliefDays  Int?
  painLevel   Int?
  notes       String?
  createdAt   DateTime @default(now())
  treatmentId Int

  Treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([treatmentId])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Injury    Injury[]
}

model DocumentChunk {
  id                    Int      @id @default(autoincrement())
  injuryId              Int
  userId                Int
  sourceType            String
  sourceId              Int
  chunkIndex            Int
  content               String
  embedding             Unsupported("vector(1024)")?
  embeddingModel        String
  embeddingModelVersion String
  metadata              Json?
  createdAt             DateTime @default(now())

  Injury Injury @relation(fields: [injuryId], references: [id])

  @@index([injuryId])
  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([embeddingModel, embeddingModelVersion])
  @@unique([sourceType, sourceId, chunkIndex])
}
