# Required. MUST be the journal app's database -- the exact same value as
# DATABASE_URL in backend/.env. This service reads the user's real journal
# data; it does not keep its own copy. Pointing it anywhere else is what made
# the assistant answer from seeded data nobody had written.
#
# This app does NOT own that schema. backend/prisma/ does, including the
# DocumentChunk table this service writes vectors into. Never run
# `prisma migrate` against it -- scripts/assert-local-db.mjs enforces that.
#
# The local docker-compose database (injury-journal-ai-db) is now only for
# integration tests and the evaluation harness; use `npm run dev:up:seed`.
DATABASE_URL=
# Required. Used by src/llm/llm-client.ts for answer generation (Groq).
GROQ_API_KEY=
# Required. Shared secret sent as a Bearer token to the embedding service
# (src/embeddings/embedding_api.py) and must also be set in that service's
# own process environment.
EMBEDDING_API_KEY=
# Required. Shared secret used to verify Bearer JWTs on POST /ai-agent and
# GET /injuries (src/auth/authenticate.ts). This MUST be the exact same value
# as JWT_SECRET in backend/.env — that app issues the tokens this one verifies
# (see docs/02-architecture.md D10). Any string works locally, as long as both
# apps use the same one. To sign a token by hand for dev/testing:
# node -e "console.log(require('jsonwebtoken').sign({ userId: 1 }, '<value>', { algorithm: 'HS256' }))"
JWT_SECRET=
# Optional. Comma-separated list of allowed CORS origins. Leave unset until a
# real frontend origin is deployed (see README).
ALLOWED_ORIGIN=
